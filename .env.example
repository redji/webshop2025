# Shared / docker-compose defaults (copy to .env — do not commit secrets)

POSTGRES_USER=webshop
POSTGRES_PASSWORD=webshop
POSTGRES_DB=webshop
POSTGRES_PORT=5432

RABBITMQ_USER=webshop
RABBITMQ_PASSWORD=webshop
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

API_PORT=3001
WEB_PORT=3000

# Browser-facing API URL (baked into the Next.js client bundle at image build)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side API URL for RSC fetches inside Docker (Compose service DNS)
API_URL=http://api:3001

# Frontend origin (CORS + OAuth post-login redirect)
FRONTEND_URL=http://localhost:3000

# Cookie flags for the API session cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Google OAuth 2.0 ---
# Redirect URI to register: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Microsoft identity platform ---
# Redirect URI to register: http://localhost:3001/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

# --- Facebook Login ---
# Redirect URI to register: http://localhost:3001/auth/facebook/callback
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# SonarQube Community (local Docker — profile: sonar)
# UI: http://localhost:9000 — first login admin / admin (change immediately)
# Create a user token in Sonar UI and set SONAR_TOKEN here (do not commit the real token).
SONAR_HOST_URL=http://localhost:9000
SONAR_PORT=9000
SONAR_TOKEN=
