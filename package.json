{
  "name": "webshop2025",
  "version": "1.0.0",
  "private": true,
  "description": "Webshop 2025 monorepo — Nest.js API + Next.js storefront",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sonar:up": "docker compose --profile sonar up -d sonarqube",
    "sonar:down": "docker compose --profile sonar stop sonarqube",
    "sonar:scan": "docker compose --profile sonar run --rm sonar-scanner",
    "sonar": "npm run sonar:up && npm run sonar:scan"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
