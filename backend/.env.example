NODE_ENV=development
PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=webshop
DATABASE_PASSWORD=webshop
DATABASE_NAME=webshop

RABBITMQ_URL=amqp://webshop:webshop@localhost:5672

# Frontend origin for CORS + post-login redirect
FRONTEND_URL=http://localhost:3000

# Cookie flags (localhost: keep secure=false, sameSite=lax)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Google OAuth 2.0 ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Microsoft identity platform (Azure AD) ---
# Portal: https://portal.azure.com → App registrations
# Redirect URI (Web): http://localhost:3001/auth/microsoft/callback
# API permissions: Microsoft Graph → User.Read (delegated)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

# --- Facebook Login ---
# Console: https://developers.facebook.com/apps
# Valid OAuth Redirect URI: http://localhost:3001/auth/facebook/callback
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# --- Google reCAPTCHA v2 (checkbox) ---
# https://www.google.com/recaptcha/admin — type: reCAPTCHA v2 Checkbox
# Without real keys, OAuth start fails closed unless RECAPTCHA_DISABLED=true
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_DISABLED=false
